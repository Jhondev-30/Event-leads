---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Calendario de Convocatorias 2027 | SpeakUp Express",
  description = "Ventana estratégica de postulación de conferencistas (5 a 10 meses). Organización cronológica y colaborativa."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23E50C13' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect width='18' height='18' x='3' y='4' rx='2'/><line x1='16' x2='16' y1='2' y2='6'/><line x1='8' x2='8' y1='2' y2='6'/><line x1='3' x2='21' y1='10' y2='10'/></svg>">

  <!-- Human-First Editorial Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- GSAP & Lucide Icons -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script is:inline src="https://unpkg.com/lucide@latest"></script>

  <style is:global>
    :root {
      --bg-red: #B80A0F;
      --brand-red: #E50C13;
      --brand-red-hover: #ff1c24;
      --red-accent: #FF4D47;
      --stage-black: #0A0A0A;
      --stage-card: #121212;
      --stage-card-hover: #181818;
      --pure-white: #FFFFFF;
      --gray-light: #F2F2F2;
      --gray-muted: #8E8E93;
      --border-subtle: rgba(255, 255, 255, 0.1);
      --border-focus: rgba(229, 12, 19, 0.7);
      --font-display: 'Fraunces', Georgia, serif;
      --font-ui: 'Inter', system-ui, -apple-system, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-ui);
      background-color: var(--bg-red);
      background-image: radial-gradient(circle at 50% 0%, #E50C13 0%, #8A060A 60%, #440204 100%);
      background-attachment: fixed;
      color: var(--pure-white);
      min-height: 100vh;
      line-height: 1.5;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }
  </style>
</head>
<body>
  <slot />
</body>
</html>
